#!/bin/bash
# Preserve Kbuild's argument boundaries and validation policy. The sole accepted
# limitation is a known diagnostic for the linked module with the pinned core.
# The mandatory per-file target validates/transforms every first-party object.
set -u
kernel_build=${objtree:-}
[[ -n $kernel_build ]] || { echo 'objtool_wrapper: missing objtree' >&2; exit 1; }
objtool=$kernel_build/tools/objtool/objtool
[[ -x $objtool && $# -gt 0 ]] || { echo 'objtool_wrapper: missing objtool or arguments' >&2; exit 1; }

source_dir=${FUSION_DRIVER_DIR:-$PWD}
module=${FIO_DRIVER_NAME:-iomemory-vsl}
object=${!#}
linked=0
for arg in "$@"; do [[ $arg != --link ]] || linked=1; done
expected_object=0
if [[ $object == "$source_dir/$module.o" || ( $PWD == "$source_dir" && $object == "$module.o" ) ]]; then
    expected_object=1
fi
if (( linked && expected_object )); then
    # NUL-delimited, never eval'd. Save exactly the kernel options, without the
    # object operand, for the mandatory per-file transformation/validation pass.
    printf '%s\0' "${@:1:$#-1}" > "$source_dir/.objtool-link-args" || exit 1
fi

if output=$("$objtool" "$@" 2>&1); then rc=0; else rc=$?; fi
[[ -z $output ]] || printf '%s\n' "$output" >&2
if (( rc == 0 )); then
    if (( linked && expected_object )); then
        rm -f -- "$source_dir/.objtool-link-needs-perfile"
    fi
    exit 0
fi

major=$(cut -d. -f1 "$kernel_build/include/config/kernel.release" 2>/dev/null)
blob=${KFIO_LIB:-}
[[ $blob == /* ]] || blob=$source_dir/$blob
# This pins the reviewed latest/cc63 bytes; it is not a provenance or license
# claim. A changed/other binary needs review before receiving any exception.
known_hash=61ee1425207b317c9c327c7c9080ab201fdd01625a6138d893abd63d42021a4d
actual_hash=$(sha256sum "$blob" 2>/dev/null) || actual_hash=''
if (( linked && expected_object )) && [[ $major =~ ^[0-9]+$ ]] && (( major >= 7 )) \
        && [[ ${actual_hash%% *} == "$known_hash" && -n $output ]]; then
    known_only=1
    while IFS= read -r line; do
        # objtool's warning format comes from tools/objtool/include/objtool/warn.h.
        # No substring whitelist: every nonempty line must be this diagnostic.
        [[ -n $line ]] || continue
        if [[ $line == "$object: "* ]]; then
            diagnostic=${line#"$object: "}
        else
            known_only=0
            break
        fi
        if ! [[ $diagnostic =~ ^(error|warning):\ objtool:\ [[:alnum:]_.]+\+0x[[:xdigit:]]+(\ \([[:alnum:]_.]+\+0x[[:xdigit:]]+\))?:\ unannotated\ intra-function\ call$ ]]; then
            known_only=0
            break
        fi
    done <<< "$output"
    if (( known_only )); then
        touch "$source_dir/.objtool-link-needs-perfile" || exit 1
        printf '%s\n' 'objtool_wrapper: pinned core has an unannotated call; whole-core validation remains unavailable' >&2
        exit 0
    fi
fi
printf 'objtool_wrapper: validation failed (exit %s); refusing unknown/first-party diagnostics\n' "$rc" >&2
exit "$rc"
